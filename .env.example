NODE_ENV=development
PORT=8080
# S3 configuration - for development with MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=metashot-images
S3_REGION=us-east-1
# For production with AWS S3, remove S3_ENDPOINT to use AWS defaults
PRESIGNED_URL_EXPIRY=3600
METABASE_SITE_URL=http://localhost:3000
METABASE_SECRET_KEY=test
# Authentication: REQUIRED unless you explicitly opt out. The server refuses
# to start without AUTH_TOKEN unless ALLOW_UNAUTHENTICATED=true (dev-only).
AUTH_TOKEN=change-me
# ALLOW_UNAUTHENTICATED=false
# Rate limiting for screenshot endpoint
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Screenshot resource limits
# Requested viewport dimensions are clamped into this range
SCREENSHOT_MIN_DIMENSION=320
SCREENSHOT_MAX_DIMENSION=4096
# Screenshot jobs rendered at the same time; extra requests wait in a bounded
# queue and are rejected with 503 once that queue is full
SCREENSHOT_MAX_CONCURRENCY=4
SCREENSHOT_MAX_QUEUE_DEPTH=20
# Overall deadline for a single screenshot request (504 when exceeded)
SCREENSHOT_REQUEST_TIMEOUT_MS=120000
# Maximum accepted JSON request body size
REQUEST_BODY_LIMIT=100kb
# Enable trust proxy when behind a reverse proxy (e.g., nginx, load balancer)
# This allows Express to correctly read client IP from X-Forwarded-For header
TRUST_PROXY=false
# Tracing configuration (optional)
# TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Note: Ensure OTLP endpoints use TLS (https://) in production environments for secure telemetry transmission.

